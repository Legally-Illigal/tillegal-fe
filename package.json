    "date-fns": "^4.4.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
